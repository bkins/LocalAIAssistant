<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:LocalAIAssistant.Converters"
             x:Class="LocalAIAssistant.Views.MemoryManagementPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:UtcToLocalDateTimeConverter x:Key="UtcToLocalDateTimeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="MainLayout"
          RowDefinitions="Auto,Auto,*">
        <!-- Row 0: Pending memory confirmation badge banner -->
        <Border Grid.Row="0"
                Margin="15,10,15,5"
                Padding="15,12"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Stroke="{StaticResource Primary}"
                BackgroundColor="{StaticResource PurpleSurface}"
                IsVisible="{Binding HasPendingMemoryConfirmation}">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Label Text="🧠" FontSize="24" VerticalOptions="Center" />
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Provisional Memories Pending" 
                           FontAttributes="Bold" 
                           FontSize="14" 
                           TextColor="{StaticResource Secondary}"
                           AutomationId="ProvisionalMemoriesPendingLabel" />
                    <Label Text="{Binding PendingMemoryConfirmationCount, StringFormat='You have {0} provisional memories waiting for confirmation.'}" 
                           FontSize="12" 
                           TextColor="{StaticResource SecondaryTextColor}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <!-- Row 1: Action Buttons -->
        <HorizontalStackLayout Grid.Row="1"
                               Padding="10"
                               Spacing="15"
                               HorizontalOptions="Center">
            <!--Command="{Binding ClearShortTermAsyncCommand}" -->
            <Button x:Name="ClearShorTermButton"
                    AutomationId="ClearShorTermButton"
                    Text="Clear Short Term" 
                    Clicked="ClearShorTermButton_OnClicked"
                    BackgroundColor="{StaticResource DangerColor}" 
                    TextColor="White"
                    CornerRadius="8"/>
            <!--Command="{Binding ClearLongTermAsyncCommand}" -->
            <Button x:Name="ClearLongTermButton"
                    AutomationId="ClearLongTermButton"
                    Text="Clear Long Term" 
                    Clicked="ClearLongTermButton_OnClicked"
                    BackgroundColor="{StaticResource WarningColor}" 
                    TextColor="White"
                    CornerRadius="8"/>
            <!--Command="{Binding RefreshAsyncCommand}"-->
            <Button x:Name="RefreshButton"
                    AutomationId="RefreshButton"
                    Text="Refresh" 
                    Clicked="RefreshButton_OnClicked"
                    BackgroundColor="{StaticResource SuccessColor}" 
                    TextColor="White"
                    CornerRadius="8"/>
        </HorizontalStackLayout>
    
        <!-- Row 2: Short & Long Term Memory CollectionViews -->
        <Grid Grid.Row="2"
              Padding="10"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,*"
              ColumnSpacing="10">

            <!-- Column headers -->
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Text="Short Term Memory"
                   FontAttributes="Bold"
                   FontSize="Medium"
                   HorizontalOptions="Center"/>
            <Label Grid.Row="0"
                   Grid.Column="1"
                   Text="Long Term Memory"
                   FontAttributes="Bold"
                   FontSize="Medium"
                   HorizontalOptions="Center"/>

            <!-- Short Term Messages -->
            <CollectionView Grid.Row="1"
                            Grid.Column="0"
                            ItemsSource="{Binding ShortTermMessages}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="5"
                               Margin="3"
                               BorderColor="LightGray"
                               CornerRadius="6">
                            <VerticalStackLayout>
                                <Label Text="{Binding Sender}"
                                       FontAttributes="Bold"
                                       FontSize="Small"/>
                                <Label Text="{Binding Content}"
                                       FontSize="Small"/>
                                <Label Text="{Binding Timestamp, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}"
                                       FontSize="Micro"
                                       TextColor="Gray"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Long Term Messages -->
            <CollectionView Grid.Row="1"
                            Grid.Column="1"
                            ItemsSource="{Binding LongTermMessages}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="5"
                               Margin="3"
                               BorderColor="LightGray"
                               CornerRadius="6">
                            <VerticalStackLayout>
                                <Label Text="{Binding Sender}"
                                       FontAttributes="Bold"
                                       FontSize="Small"/>
                                <Label Text="{Binding Content}"
                                       FontSize="Small"/>
                                <Label Text="{Binding Timestamp, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}"
                                       FontSize="Micro"
                                       TextColor="Gray"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>

</ContentPage>
