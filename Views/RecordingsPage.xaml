<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LocalAIAssistant.ViewModels"
             xmlns:core="clr-namespace:LocalAIAssistant.Core.ConversationRecorder;assembly=LocalAIAssistant.Core"
             x:Class="LocalAIAssistant.Views.RecordingsPage"
             x:DataType="viewModels:RecordingsViewModel"
             Title="Conversation Recorder"
             BackgroundColor="{StaticResource SplashBackgroundColor}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Recorder Header & Timer Controls -->
        <Border Grid.Row="0"
                Margin="12,12,12,6"
                Padding="16"
                BackgroundColor="{StaticResource SurfaceColor}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                
                <Label Text="Offline Conversation Recorder"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource PrimaryTextColor}"/>

                <Label Text="{Binding ElapsedTimeDisplay}"
                       FontSize="36"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource PrimaryTextColor}"/>

                <!-- Recording Controls (Record -> Pause -> Resume & Stop) -->
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Button AutomationId="RecordToggleButton"
                            Text="{Binding RecordingButtonText}"
                            Command="{Binding ToggleRecordingCommand}"
                            BackgroundColor="{StaticResource SuccessColor}"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            Padding="20,10"
                            CornerRadius="8"/>

                    <Button AutomationId="RecordStopButton"
                            Text="Stop"
                            Command="{Binding StopRecordingCommand}"
                            IsVisible="{Binding IsRecording}"
                            BackgroundColor="Red"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            Padding="20,10"
                            CornerRadius="8"/>
                </HorizontalStackLayout>

                <!-- Live Copilot Toggle -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Live Copilot"
                           FontSize="13"
                           TextColor="{StaticResource SecondaryTextColor}"
                           VerticalOptions="Center"/>
                    <Switch IsToggled="{Binding IsCopilotEnabled}"
                            AutomationId="CopilotToggle"
                            VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Continuous Live Streaming Toggle (Desktop Only) -->
                <HorizontalStackLayout Spacing="8"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsDesktopPlatform}">
                    <Label Text="Live Streaming Mode (Desktop)"
                           FontSize="13"
                           TextColor="{StaticResource SecondaryTextColor}"
                           VerticalOptions="Center"/>
                    <Switch IsToggled="{Binding IsLiveStreamingMode}"
                            AutomationId="LiveStreamingToggle"
                            VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Desktop Live Teleprompter / Closed Captioning Card -->
                <Border IsVisible="{Binding IsLiveStreamingMode}"
                        Margin="0,4,0,0"
                        Padding="12,8"
                        BackgroundColor="#0F172A"
                        Stroke="#475569"
                        StrokeThickness="1"
                        MaximumHeightRequest="160">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Live Captions &amp; Diarization"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#94A3B8"/>
                            <Label Grid.Column="1"
                                   Text="{Binding LiveSpeakerBalanceDisplay}"
                                   FontSize="11"
                                   TextColor="#38BDF8"
                                   FontAttributes="Bold"/>
                        </Grid>
                        <ScrollView MaximumHeightRequest="110">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding LiveTranscriptSegments}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="core:TranscriptSegmentDto">
                                        <HorizontalStackLayout Spacing="6">
                                            <Border BackgroundColor="#334155" Padding="4,1" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding SpeakerLabel}" FontSize="10" TextColor="#F8FAFC" FontAttributes="Bold"/>
                                            </Border>
                                            <Label Text="{Binding Text}" FontSize="12" TextColor="#E2E8F0" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- In-Flight Copilot Insight Card -->
                <Border IsVisible="{Binding HasActiveCopilotInsight}"
                        Margin="0,4,0,0"
                        Padding="12,8"
                        BackgroundColor="#1E293B"
                        Stroke="#3B82F6"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="💡"
                               FontSize="16"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding ActiveCopilotInsight.Headline}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#60A5FA"/>
                            <Label Text="{Binding ActiveCopilotInsight.Detail}"
                                   FontSize="12"
                                   TextColor="#E2E8F0"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="✕"
                                Command="{Binding DismissCopilotInsightCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#94A3B8"
                                FontSize="14"
                                Padding="6,2"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource SecondaryTextColor}"/>

            </VerticalStackLayout>
        </Border>

        <!-- Section Title -->
        <Grid Grid.Row="1"
              Margin="16,12,16,4"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                <Label Text="Saved Recordings"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryTextColor}"/>
                <Label Text="{Binding TotalStorageSizeDisplay}"
                       FontSize="12"
                       TextColor="{StaticResource SecondaryTextColor}"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Refresh"
                    Command="{Binding RefreshCommand}"
                    Padding="10,4"
                    FontSize="12"/>
        </Grid>

        <!-- Recordings List -->
        <CollectionView Grid.Row="2"
                        AutomationId="RecordingsList"
                        ItemsSource="{Binding Recordings}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RecordingItemViewModel">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="Red"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:RecordingsViewModel}}, Path=DeleteRecordingCommand}"
                                           CommandParameter="{Binding}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Padding="14,12"
                                Margin="12,4"
                                BackgroundColor="{StaticResource SurfaceColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <!-- View Title -->
                                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsEditingTitle, Converter={StaticResource InverseBoolConverter}}">
                                            <Label Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource PrimaryTextColor}"
                                                   VerticalOptions="Center"/>
                                            <Button Text="✏️"
                                                    Command="{Binding ToggleEditTitleCommand}"
                                                    Padding="4,0"
                                                    FontSize="11"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource PrimaryTextColor}"/>
                                        </HorizontalStackLayout>

                                        <!-- Edit Title Entry -->
                                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsEditingTitle}">
                                            <Entry Text="{Binding Title}"
                                                   FontSize="13"
                                                   WidthRequest="160"
                                                   VerticalOptions="Center"/>
                                            <Button Text="Save"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:RecordingsViewModel}}, Path=SaveTitleCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,2"
                                                    FontSize="11"
                                                    BackgroundColor="#512BD4"
                                                    TextColor="White"/>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding StartedAtDisplay}"
                                               FontSize="11"
                                               TextColor="{StaticResource SecondaryTextColor}"/>

                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding DurationDisplay, StringFormat='Duration: {0}'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource SecondaryTextColor}"/>
                                            <Label Text="{Binding FileSizeDisplay, StringFormat='Size: {0}'}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource SecondaryTextColor}"/>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Status, StringFormat='Status: {0}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource SecondaryTextColor}"/>
                                    </VerticalStackLayout>

                                    <!-- Audio Player Controls (Play / Pause / Resume & Stop) -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" Margin="4,0">
                                        <Button Text="{Binding IsPlaying, Converter={StaticResource InverseBoolConverter}, StringFormat='Play'}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:RecordingsViewModel}}, Path=PlayRecordingCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4"
                                                FontSize="12"/>

                                        <Button Text="Stop"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:RecordingsViewModel}}, Path=StopPlaybackCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsPlaying}"
                                                BackgroundColor="DarkRed"
                                                TextColor="White"
                                                Padding="8,4"
                                                FontSize="12"/>
                                    </HorizontalStackLayout>

                                    <!-- Transcribe Action -->
                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" Margin="4,0">
                                        <ActivityIndicator IsRunning="{Binding IsTranscribing}"
                                                           IsVisible="{Binding IsTranscribing}"
                                                           WidthRequest="20" HeightRequest="20"/>

                                        <Button Text="Transcribe"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:RecordingsViewModel}}, Path=TranscribeAndDiarizeCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsTranscribing, Converter={StaticResource InverseBoolConverter}}"
                                                BackgroundColor="#512BD4"
                                                TextColor="White"
                                                Padding="10,4"
                                                FontSize="12"/>
                                    </HorizontalStackLayout>

                                    <!-- Transcript Toggle -->
                                    <Button Grid.Column="3"
                                            Text="Transcript"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:RecordingsViewModel}}, Path=ToggleTranscriptCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"
                                            FontSize="11"
                                            VerticalOptions="Center"/>
                                </Grid>

                                <!-- Expanded Transcript & Speaker Mapping Section -->
                                <VerticalStackLayout IsVisible="{Binding IsTranscriptExpanded}"
                                                     Spacing="10"
                                                     Margin="0,8,0,0"
                                                     Padding="10"
                                                     BackgroundColor="{StaticResource SplashBackgroundColor}">

                                    <Label Text="Speaker Mapping"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryTextColor}"/>

                                    <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                        <Entry Grid.Row="0" Grid.Column="0"
                                               Text="{Binding SpeakerName1}"
                                               Placeholder="Speaker 1 Name"
                                               FontSize="12"/>
                                        <Entry Grid.Row="0" Grid.Column="1"
                                               Text="{Binding SpeakerName2}"
                                               Placeholder="Speaker 2 Name"
                                               FontSize="12"/>
                                        <Entry Grid.Row="1" Grid.Column="0"
                                               Text="{Binding SpeakerName3}"
                                               Placeholder="Speaker 3 Name (optional)"
                                               FontSize="12"/>
                                        <Entry Grid.Row="1" Grid.Column="1"
                                               Text="{Binding SpeakerName4}"
                                               Placeholder="Speaker 4 Name (optional)"
                                               FontSize="12"/>
                                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                                Text="Save Speakers"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:RecordingsViewModel}}, Path=SaveSpeakerMapCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4"
                                                FontSize="11"/>
                                    </Grid>

                                    <Label Text="Transcript Segments"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryTextColor}"
                                           Margin="0,4,0,0"/>

                                    <Label Text="No transcript available yet. Tap 'Transcribe' to process this recording."
                                           IsVisible="{Binding HasTranscript, Converter={StaticResource InverseBoolConverter}}"
                                           FontSize="12"
                                           TextColor="{StaticResource SecondaryTextColor}"/>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Segments}"
                                                         Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:TranscriptSegmentViewModel">
                                                <Border Padding="8" BackgroundColor="{StaticResource SurfaceColor}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6"/>
                                                    </Border.StrokeShape>
                                                    <VerticalStackLayout Spacing="2">
                                                        <HorizontalStackLayout Spacing="8">
                                                            <Label Text="{Binding SpeakerLabel}"
                                                                   FontAttributes="Bold"
                                                                   FontSize="12"
                                                                   TextColor="{StaticResource PrimaryTextColor}"/>
                                                            <Label Text="{Binding TimeRangeDisplay}"
                                                                   FontSize="11"
                                                                   TextColor="{StaticResource SecondaryTextColor}"/>
                                                        </HorizontalStackLayout>
                                                        <Label Text="{Binding Text}"
                                                               FontSize="12"
                                                               TextColor="{StaticResource PrimaryTextColor}"/>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8"
                                     Padding="32">
                    <Label Text="No conversation recordings"
                           FontSize="15"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource SecondaryTextColor}"/>
                    <Label Text="Tap 'Record' to capture an offline conversation."
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource SecondaryTextColor}"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</ContentPage>
