<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LocalAIAssistant.ViewModels"
             xmlns:controls="clr-namespace:LocalAIAssistant.Views.Controls"
             xmlns:dto="clr-namespace:LocalAIAssistant.Core.ConversationHistory;assembly=LocalAIAssistant.Core"
             x:Class="LocalAIAssistant.Views.AgentChatPage"
             x:DataType="viewModels:AgentChatViewModel"
             Title="Antigravity Assistant"
             BackgroundColor="{StaticResource SplashBackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header / Thread Selector Toolbar -->
        <Grid Grid.Row="0"
              Padding="12,8"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{StaticResource SurfaceColor}">

            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                <Label Text="Antigravity Remote Chat"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryTextColor}"/>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="Thread:"
                           FontSize="12"
                           TextColor="{StaticResource SecondaryTextColor}"
                           VerticalOptions="Center"/>
                    <Picker ItemsSource="{Binding Conversations}"
                            SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                            ItemDisplayBinding="{Binding Name}"
                            TextColor="{StaticResource PrimaryTextColor}"
                            Title="Select Conversation"
                            FontSize="13"
                            MinimumWidthRequest="220"
                            VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </Grid>

        <!-- Chat History -->
        <Grid Grid.Row="1" Margin="12">
            
            <CollectionView ItemsSource="{Binding Messages}"
                            ItemsUpdatingScrollMode="KeepLastItemInView"
                            VerticalOptions="FillAndExpand">
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ConversationTurnDto">
                        <Border Padding="12"
                                Margin="0,6"
                                Stroke="#000000"
                                StrokeThickness="0"
                                MaximumWidthRequest="480"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                BackgroundColor="{StaticResource SurfaceColor}">
                            
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Role}"
                                             Value="user">
                                    <Setter Property="BackgroundColor"   Value="#4CAF50" />
                                    <Setter Property="HorizontalOptions" Value="End" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding Role}"
                                             Value="assistant">
                                    <Setter Property="BackgroundColor"   Value="#7C5CE6" />
                                    <Setter Property="HorizontalOptions" Value="Start" />
                                </DataTrigger>
                            </Border.Triggers>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Role}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource SecondaryTextColor}"
                                       Opacity="0.75" />
                                <controls:NativeMarkdownView Markdown="{Binding Content}"
                                                             HorizontalOptions="Fill"
                                                             VerticalOptions="Start" />
                                <Label Text="{Binding Timestamp, StringFormat='{0:t}'}"
                                       FontSize="9"
                                       TextColor="{StaticResource SecondaryTextColor}"
                                       HorizontalOptions="End"
                                       Opacity="0.6"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{StaticResource PrimaryTextColor}"/>
        </Grid>

        <!-- Input / Action Bottom Bar -->
        <Grid Grid.Row="2"
              RowDefinitions="Auto,Auto"
              Padding="12"
              BackgroundColor="{StaticResource SurfaceColor}">

            <!-- Status Indicator -->
            <Label Grid.Row="0"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   TextColor="#FFD700"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,8"
                   IsVisible="{Binding HasStatusText}"/>

            <!-- Input Controls -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                <Editor Grid.Column="0"
                        Text="{Binding PromptText, Mode=TwoWay}"
                        Placeholder="Type a prompt for Antigravity workstation..."
                        PlaceholderColor="{StaticResource SecondaryTextColor}"
                        TextColor="{StaticResource PrimaryTextColor}"
                        AutoSize="TextChanges"
                        MaximumHeightRequest="120"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource SplashBackgroundColor}"
                        Margin="0" />

                <Button Grid.Column="1"
                        AutomationId="SendAgentPromptButton"
                        Text="Send"
                        Command="{Binding SendPromptCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="#7C5CE6"
                        TextColor="White"
                        CornerRadius="6"
                        VerticalOptions="End"
                        Padding="16,10"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
