<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:logging="clr-namespace:LocalAIAssistant.Services.Logging"
             x:Class="LocalAIAssistant.Views.LogDetailPage"
             x:DataType="logging:LogEntry"
             Title="Log Details"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource AppBackgroundColor}}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            
            <!-- Metadata Summary Card -->
            <Border Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceColor}}"
                    Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                        <!-- Level Badge -->
                        <Border Grid.Column="0"
                                BackgroundColor="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,3">
                            <Label Text="{Binding Level}"
                                   FontSize="12"
                                   TextColor="White"
                                   FontAttributes="Bold" />
                        </Border>

                        <!-- Category Badge -->
                        <Border Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceAltColor}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,3">
                            <Label Text="{Binding Category}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray300}}" />
                        </Border>

                        <!-- Exception Flag -->
                        <Label Grid.Column="2"
                               Text="⚠ Exception Captured"
                               FontSize="11"
                               TextColor="#E53935"
                               FontAttributes="Bold"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasException}" />
                    </Grid>

                    <Label Text="{Binding FormattedTimestamp, StringFormat='Timestamp: {0}'}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Message Card -->
            <Border Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceColor}}"
                    Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Message"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="📋 Copy Message"
                                Clicked="OnCopyMessageClicked"
                                FontSize="11"
                                CornerRadius="6"
                                Padding="10,4"
                                HeightRequest="30"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                    </Grid>

                    <Label Text="{Binding Message}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Exception Card (Visible if HasException is true) -->
            <Border IsVisible="{Binding HasException}"
                    Stroke="#E53935"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=#FFF8F8, Dark=#2A1215}"
                    Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="⚠ Exception &amp; Stack Trace"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#E53935"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="📋 Copy Stack Trace"
                                Clicked="OnCopyExceptionClicked"
                                FontSize="11"
                                CornerRadius="6"
                                Padding="10,4"
                                HeightRequest="30"
                                BackgroundColor="#FFCDD2"
                                TextColor="#B71C1C" />
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E0C0E}"
                            Stroke="#FFCDD2"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10">
                        <Label Text="{Binding Exception}"
                               FontFamily="Consolas, monospace"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#B71C1C, Dark=#FF8A80}"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Structured Properties Card (Visible if Properties exist) -->
            <Border IsVisible="{Binding Properties.Count, Converter={StaticResource IntGreaterThanZeroConverter}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceColor}}"
                    Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Context Properties"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceAltColor}}"
                            StrokeShape="RoundRectangle 6"
                            Padding="10">
                        <Label Text="{Binding PropertiesFormatted}"
                               FontFamily="Consolas, monospace"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray300}}"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Raw Prettified JSON Card -->
            <Border Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceColor}}"
                    Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Raw Event JSON"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="📋 Copy Raw JSON"
                                Clicked="OnCopyRawJsonClicked"
                                FontSize="11"
                                CornerRadius="6"
                                Padding="10,4"
                                HeightRequest="30"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceAltColor}}"
                            StrokeShape="RoundRectangle 6"
                            Padding="10">
                        <Label Text="{Binding PrettifiedFullText}"
                               FontFamily="Consolas, monospace"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray300}}"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>